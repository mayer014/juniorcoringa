# Endereço público do site, sem barra no final
NEXT_PUBLIC_SITE_URL=https://seudominio.com.br

# Acesso ao painel /admin
ADMIN_EMAIL=admin@seudominio.com.br
ADMIN_PASSWORD=defina-uma-senha-longa-e-unica

# Gere com: openssl rand -base64 48
SESSION_SECRET=troque-por-uma-chave-aleatoria-longa

# No Docker/EasyPanel, mantenha este caminho e monte um volume persistente nele
DATA_DIR=/app/data
